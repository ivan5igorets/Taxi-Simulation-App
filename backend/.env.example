# Локальная разработка: хост-порт 5433 (5432 может быть занят другим проектом).
# В докер-компоузе (прод) DATABASE_URL переопределяется в docker-compose.yml
# на postgres://taxi:${POSTGRES_PASSWORD}@db:5432/taxi — эта строка ниже нужна
# только для локального "npm run dev" без Docker вокруг backend.
DATABASE_URL=postgres://taxi:taxi@localhost:5433/taxi
PORT=3100

# Центр симуляции — Киев
CITY_LAT=50.4501
CITY_LON=30.5234
SPAWN_RADIUS_M=3000

# Интервал тика воркера, мс
TICK_MS=5000

# Воркер засыпает после стольки мс без единого /api/* запроса (10 минут)
WORKER_IDLE_TIMEOUT_MS=600000

# Публичный демо-сервер OSRM (маршруты по улицам). Свой инстанс — смени адрес.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=3000
